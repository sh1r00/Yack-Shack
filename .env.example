# Shopify Storefront API
SHOPIFY_STOREFRONT_ENDPOINT=https://your-store.myshopify.com/api/2023-10/graphql
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Demo mode (spoofed yak-fur catalog). Set to 'false' to connect to the Shopify store above.
DEMO_MODE=true

# App Configuration
APP_NAME=Yack-Shack
APP_SHORT_NAME=YackShack
APP_DESCRIPTION=Luxurious yak fur goods — blankets, apparel & home decor spun from Himalayan yak.
APP_AUTHOR=Yack-Shack
APP_BASE_URL=https://yack-shack.example.com
APP_CATEGORY=yak
APP_LANG=en

# Security (leave blank for defaults)
APP_WHITE_LIST=
WHITE_LIST_WORKBOX=
WHITE_LIST_IMG_SRC=

# Optional
LOG_LEVEL=info
TWITTER_HANDLE=
TWITTER_USERNAME=

# Analytics (Umami) — set a website id to enable tracking.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
